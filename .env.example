# Database (required) — start PostgreSQL via: docker compose up -d (or use Supabase/Neon/Vercel Postgres)
DATABASE_URL="postgresql://algochef:algochef@localhost:5432/algochef"

# OpenAI (optional) — leave empty to use mock mode with sample responses
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# API server (for NestJS backend if running separately)
API_PORT=3001

# Frontend → API connection
# On Vercel: leave empty to use built-in Next.js serverless API routes (/api)
# Or set to your VPS API URL (e.g. https://api.yourdomain.com)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# CORS origin for the NestJS API (must match the web app URL)
WEB_ORIGIN="http://localhost:3000"

# ── Production (Docker Compose on VPS) ─────────────────────────
# POSTGRES_USER=algochef
# POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
# POSTGRES_DB=algochef
# POSTGRES_PORT=5435
